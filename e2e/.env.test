# Environment for the end-to-end suite (e2e/). Dummy values only: nothing here is a real secret.
# Variables already set in the shell take precedence (e.g. DATABASE_URL for a local database).

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ostiary_e2e
BETTER_AUTH_SECRET=e2e-dummy-secret-not-for-production-0123456789
AUTH_APP_URL=http://localhost:3220
BETTER_AUTH_URL=http://localhost:3220
NEXT_PUBLIC_APP_URL=http://localhost:3220
ADMIN_APP_URL=http://localhost:3221
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3221
# Required by `next start` (NODE_ENV=production); nothing is sent, see E2E_TEST_MODE.
RESEND_API_KEY=re_e2e_dummy_never_used
RESEND_FROM=Ostiary E2E <e2e@example.test>

# Test seams (packages/core/src/lib/e2e-test-mode.ts). Only honoured with a loopback http:// AUTH_APP_URL.
E2E_TEST_MODE=true
# Outgoing emails are appended here (JSON lines) instead of being sent. Relative to e2e/.
E2E_MAIL_FILE=.data/mail.jsonl

# Sign-ups with these addresses become admins (the second one checks the two-factor gate).
ADMIN_EMAILS=admin@e2e.test,gate-admin@e2e.test
REQUIRE_ADMIN_2FA=true
# On, like production. Each test sends its own x-forwarded-for, so tests never share a counter.
RATE_LIMIT_ENABLED=true
CRON_SECRET=e2e-cron-secret-0123456789

# Ports of the mock servers started by the suite (OAuth provider, webhook receiver).
E2E_MOCK_PORT=3229

# An API registered at build time (db:seed) with scopes from the environment, ready without
# waiting for the scope reload (APIs created from the console appear within a minute).
OAUTH_API_AUDIENCES=https://api.e2e.test
OAUTH_API_SCOPES=e2e:read,e2e:write
