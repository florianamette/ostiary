# Ostiary sign-in app. Copy to .env.local for local development. Every variable is documented in
# docs/configuration.md. Required: DATABASE_URL, BETTER_AUTH_SECRET, and in production RESEND_*.

# Postgres connection string, shared by both apps. On Vercel, the Neon integration (added by the
# Deploy button) sets it. Locally: `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17`
# and postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL=
# At least 32 random characters, identical in both apps: `openssl rand -base64 32`.
# It also encrypts stored provider and webhook secrets: changing it means entering them again.
BETTER_AUTH_SECRET=
# Email for verification, password reset, sign-in codes and invitations. Create an API key at
# https://resend.com/api-keys and use a sender on a domain verified in Resend, e.g.
# "Ostiary <auth@example.com>". Without them in development, links and codes are printed to the console.
RESEND_API_KEY=
RESEND_FROM=

# Origins of the apps (local defaults shown)
AUTH_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
# Shared parent domain for cross-app cookies in production, e.g. .example.com (leave unset locally).
# The session cookie is then sent to EVERY subdomain of it: only use a domain whose subdomains all
# run code you trust (docs/security.md, COOKIE_DOMAIN). Otherwise leave it unset.
COOKIE_DOMAIN=
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
PORT=3000

# First-run setup: these emails become admins when they sign up (comma-separated)
ADMIN_EMAILS=
# Admins must turn on two-factor authentication before using the admin console (default "true").
# Set to "false" to let them in without it. Set the same value in both apps.
REQUIRE_ADMIN_2FA=true
# Optional: APIs and their scopes are managed in the admin console (APIs). These variables
# declare scopes for every API (comma-separated) and APIs registered at build time.
OAUTH_API_SCOPES=
OAUTH_API_AUDIENCES=
# Optional: "Sign in with GitHub" from the environment (set it in both apps). Every other provider
# (Google, Apple, Microsoft...) is set up in the admin console, under Sign-in providers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: key for SCIM token digests (32+ characters). Defaults to one derived from BETTER_AUTH_SECRET.
SCIM_TOKEN_SECRET=
# Rate limits per client IP, counted in the database. Default: on in production, off in
# development; "true" to try them locally, "false" to turn them off.
RATE_LIMIT_ENABLED=
# Where the client IP comes from. Leave empty on Vercel (x-forwarded-for, set by Vercel).
# Anywhere else SET ONE OF THEM: without either, no header is trusted (a client could fake
# x-forwarded-for), so rate limits count all clients together and no IP is recorded.
# Behind other proxies: a header they set and clients cannot (e.g. cf-connecting-ip, x-real-ip),
# or the IPs/CIDR ranges of your proxies to read a multi-hop x-forwarded-for (comma-separated).
IP_ADDRESS_HEADERS=
TRUSTED_PROXIES=
# Optional: prefix of new API keys (default ost_). API keys themselves are turned on, and their
# maximum lifetime set, in the admin console (API keys).
API_KEY_PREFIX=
# Optional captcha on sign-up, password sign-in, password reset and sign-in codes. Set all three
# or none, before building. Provider: cloudflare-turnstile, hcaptcha or google-recaptcha (v2).
# Turnstile test keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
CAPTCHA_PROVIDER=
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# Webhooks: secret for the retry route /api/cron/webhooks (Vercel Cron sends it as a bearer token).
# 16+ random characters: `openssl rand -base64 24`.
CRON_SECRET=
# Development only: accept http://localhost webhook endpoints. Ignored in production.
WEBHOOKS_ALLOW_LOCALHOST=
# Optional: "true" adds Vercel Web Analytics (also enable it in the Vercel project, Analytics tab).
# Page views are sent without query strings, which can carry tokens.
VERCEL_ANALYTICS=
