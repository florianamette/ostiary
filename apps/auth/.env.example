# Shared by both apps: same database and secret.
DATABASE_URL=
BETTER_AUTH_SECRET=              # at least 32 characters, identical in all apps
RESEND_API_KEY=
RESEND_FROM=

# Origins of the apps (local defaults shown)
AUTH_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
# Shared parent domain for cross-app cookies in production, e.g. .example.com (leave unset locally)
COOKIE_DOMAIN=
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3001
PORT=3000

# First-run setup: these emails become admins when they sign up (comma-separated)
ADMIN_EMAILS=
# Scopes for your own APIs (comma-separated), and the APIs that may receive tokens
OAUTH_API_SCOPES=
OAUTH_API_AUDIENCES=
# Optional: "Sign in with GitHub"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
