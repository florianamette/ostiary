# Ostiary admin console (optional second app). Copy to .env.local for local development.
# Every variable is documented in docs/configuration.md.

# The same values as the auth app: one database, one secret.
DATABASE_URL=
BETTER_AUTH_SECRET=
# Email for invitations and admin-triggered messages (see apps/auth/.env.example).
RESEND_API_KEY=
RESEND_FROM=

# Origins of the two apps (local defaults shown).
AUTH_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
# Production: parent domain shared by both apps, e.g. .example.com, so one sign-in covers both.
# The session cookie is then sent to EVERY subdomain of it (docs/security.md, COOKIE_DOMAIN).
COOKIE_DOMAIN=
PORT=3001

# Same value as the auth app (default "true"): admins must turn on two-factor authentication.
REQUIRE_ADMIN_2FA=true
# MCP / Dynamic Client Registration guard rails (see apps/auth/.env.example and
# docs/mcp-and-agents.md). Set the same values as the auth app. All optional; default on.
OAUTH_ALLOW_DYNAMIC_CLIENT_REGISTRATION=
OAUTH_ALLOW_UNAUTHENTICATED_CLIENT_REGISTRATION=
OAUTH_CLIENT_REGISTRATION_SCOPES=
# Off Vercel, where the client IP comes from (see apps/auth/.env.example).
IP_ADDRESS_HEADERS=
TRUSTED_PROXIES=
# Optional: "true" adds Vercel Web Analytics (also enable it in the Vercel project).
VERCEL_ANALYTICS=
