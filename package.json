{
  "name": "ostiary",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev:auth": "pnpm --filter @ostiary/auth dev",
    "dev:admin": "pnpm --filter @ostiary/admin dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ostiary/core db:generate",
    "db:migrate": "pnpm --filter @ostiary/core db:migrate"
  },
  "description": "Self-hosted identity provider built on Better Auth: an open-source alternative to Auth0.",
  "license": "MIT"
}
