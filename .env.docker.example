# Ostiary with Docker Compose. Copy to .env next to docker-compose.yml and fill it in.
# Every variable is documented in https://www.ostiary.dev/docs/configuration; https://www.ostiary.dev/docs/self-hosting covers this setup.

# Public https addresses of the two apps (behind your reverse proxy). They are also built into
# the apps: rebuild (`docker compose up -d --build`) after changing them.
AUTH_APP_URL=https://auth.example.com
ADMIN_APP_URL=https://admin.example.com
# Shared parent domain, so one sign-in covers both apps. Read https://www.ostiary.dev/docs/security (COOKIE_DOMAIN):
# the session cookie is then sent to every subdomain of it.
COOKIE_DOMAIN=

# Database password for the bundled Postgres: `openssl rand -base64 24`.
POSTGRES_PASSWORD=
# 32+ random characters: `openssl rand -base64 32`. Also encrypts stored provider and webhook
# secrets: changing it means entering them again.
BETTER_AUTH_SECRET=
# Secret of the daily housekeeping job (webhook retries, retention): `openssl rand -base64 24`.
CRON_SECRET=

# Email (verification, password reset, sign-in codes, invitations), from https://resend.com.
RESEND_API_KEY=
RESEND_FROM="Ostiary <auth@example.com>"

# Your email address: your account becomes an admin when you sign up and verify it.
ADMIN_EMAILS=

# One account per inbox: "gmail" refuses john.doe@gmail.com when johndoe@gmail.com has an
# account (dots, +tags, googlemail.com); "plus" also ignores +tags on every domain. Off if empty.
EMAIL_DEDUP=

# Where the client IP comes from. Set the header your reverse proxy writes and clients cannot,
# e.g. x-real-ip (nginx), cf-connecting-ip (Cloudflare), or list your proxies' IPs in
# TRUSTED_PROXIES to read x-forwarded-for. Without either, rate limits count all clients together.
IP_ADDRESS_HEADERS=x-real-ip
TRUSTED_PROXIES=

# Host ports (default 3000 and 3001).
AUTH_PORT=
ADMIN_PORT=
